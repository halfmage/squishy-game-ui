---
import '../styles/global.css';
import { stories } from '../stories';
import { backgroundStyle, type BackgroundName } from '../components/backgrounds';
import Toaster from '../components/Toaster.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  bg?: BackgroundName;
  /** Story fills the viewport (screen shells). No padding, no centering. */
  fullscreen?: boolean;
}

const { title, bg = 'stripes', fullscreen = false } = Astro.props;

/** Brand themes = .theme-<id> classes in global.css */
const brands = [
  { id: 'default', label: 'Squishy' },
  { id: 'deck', label: 'Deck' },
  { id: 'blocky', label: 'Blocky' },
  { id: 'arcade', label: 'Arcade' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Squishy UI</title>
    <script is:inline>
      // Apply the saved nav state before first paint to avoid a flash.
      try {
        if (localStorage.getItem('nav-hidden') === '1') document.documentElement.classList.add('nav-hidden');
        const theme = localStorage.getItem('theme');
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
        const brand = localStorage.getItem('brand');
        if (brand && brand !== 'default') document.documentElement.classList.add('theme-' + brand);
      } catch {}
    </script>
  </head>
  <body class="bg-pattern h-screen w-screen overflow-hidden font-sans" style={backgroundStyle(bg)}>
    <nav class="playground-nav">
      <a href="/" class:list={['playground-link', current === '/' && 'is-active']}>Overview</a>
      {
        stories.map((s) => (
          <a href={s.href} class:list={['playground-link', current === s.href && 'is-active']}>
            {s.title}
          </a>
        ))
      }
    </nav>

    <button type="button" class="playground-nav-toggle" data-nav-toggle aria-label="Toggle navigation" title="Toggle navigation (H)">
      <Icon name="keyboard-arrow-up" />
    </button>
    <select class="playground-brand-select" data-brand-select aria-label="Brand theme" title="Brand theme (B cycles)">
      {brands.map((b) => <option value={b.id}>{b.label}</option>)}
    </select>
    <button type="button" class="playground-theme-toggle" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode (D)">
      <Icon name="dark-mode" />
      <Icon name="light-mode" />
    </button>

    <main class:list={['playground-main', fullscreen ? 'is-fullscreen' : 'is-centered']}>
      <slot />
    </main>
    <Toaster />

    <script>
      const root = document.documentElement;
      function toggleNav(force?: boolean) {
        const hidden = root.classList.toggle('nav-hidden', force);
        try {
          localStorage.setItem('nav-hidden', hidden ? '1' : '0');
        } catch {}
      }
      function toggleTheme(force?: boolean) {
        const dark = root.classList.toggle('dark', force);
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
      }
      const brandSelect = document.querySelector<HTMLSelectElement>('[data-brand-select]');
      const brandIds = brandSelect ? [...brandSelect.options].map((o) => o.value) : ['default'];
      function setBrand(id: string) {
        root.classList.forEach((c) => c.startsWith('theme-') && root.classList.remove(c));
        if (id !== 'default') root.classList.add('theme-' + id);
        if (brandSelect) brandSelect.value = id;
        try {
          localStorage.setItem('brand', id);
        } catch {}
      }
      // Sync the select with the class applied before paint
      const current = [...root.classList].find((c) => c.startsWith('theme-'))?.slice(6) ?? 'default';
      if (brandSelect) brandSelect.value = current;
      brandSelect?.addEventListener('change', () => setBrand(brandSelect.value));
      document.querySelector('[data-nav-toggle]')?.addEventListener('click', () => toggleNav());
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => toggleTheme());
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        const typing = t.matches?.('input, textarea, select, [contenteditable]');
        if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key.toLowerCase() === 'h') toggleNav();
        if (e.key.toLowerCase() === 'd') toggleTheme();
        if (e.key.toLowerCase() === 'b') {
          const i = brandIds.indexOf(brandSelect?.value ?? 'default');
          setBrand(brandIds[(i + 1) % brandIds.length]);
        }
      });
    </script>
  </body>
</html>
