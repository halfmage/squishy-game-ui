---
import '../styles/global.css';
import { stories } from '../stories';
import { backgroundStyle, type BackgroundName } from '../components/backgrounds';
import Toaster from '../components/Toaster.astro';

interface Props {
  title: string;
  bg?: BackgroundName;
}

const { title, bg = 'stripes' } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Squishy UI</title>
  </head>
  <body class="bg-pattern h-screen w-screen overflow-hidden font-sans" style={backgroundStyle(bg)}>
    <nav
      class="bg-white fixed rounded-xl border-4 border-zinc-900 top-4 left-4 z-50 flex flex-wrap items-center p-2 font-pixel text-xl tracking-wide text-black shadow-[inset_0_0_0_4px_rgba(255,255,255,.2),4px_4px_0_rgba(0,0,0,.25)]"
    >
      <a
        href="/"
        class:list={[
          'rounded-lg px-3 py-1 hover:bg-black/10',
          current === '/' && 'bg-black/10',
        ]}>Overview</a
      >
      {
        stories.map((s) => (
          <a
            href={s.href}
            class:list={[
              'rounded-lg px-3 py-1 hover:bg-black/10',
              current === s.href && 'bg-black/10',
            ]}
          >
            {s.title}
          </a>
        ))
      }
    </nav>

    <main
      class="flex h-full w-full flex-col items-center justify-center-safe gap-6 overflow-x-hidden overflow-y-auto p-3 pt-16"
    >
      <slot />
    </main>
    <Toaster />
  </body>
</html>
