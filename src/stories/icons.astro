---
import Icon from '../components/Icon.astro';
import Heading from '../components/Heading.astro';

export const title = 'Icons';
export const bg = 'grid';

const names = [
  'home', 'gear', 'user', 'share', 'search', 'close', 'check', 'plus', 'minus',
  'play', 'pause', 'reload', 'save', 'pencil', 'trash', 'star', 'heart',
  'volume-3', 'gamepad', 'shopping-cart', 'lock', 'circle-info', 'warning-diamond',
  'check-double', 'arrow-left', 'arrow-right', 'chevron-down', 'logout',
  'sword', 'shield', 'potion', 'fire', 'zap', 'key', 'map', 'diamond-gem', 'coins', 'clock',
  'backpack', 'fish', 'leaf', 'book-open', 'compass', 'flag', 'skull', 'castle', 'trophy', 'crown',
  'bomb', 'alien', 't-rex', 'joystick', 'chess', 'dog', 'snake', 'tree-pine', 'moon', 'sun',
];
---

<Heading>Icons</Heading>

<p class="max-w-lg text-center text-ui-sm leading-loose tracking-wide text-white">
  Icons come from
  <a href="https://pixelarticons.com/" target="_blank" rel="noopener" class="underline hover:text-white/80">Pixelarticons</a>
  (npm <code>pixelarticons</code>, 1000+ icons). Use the file name: <code>&lt;Icon name="sword" /&gt;</code>.
</p>

<div class="grid w-full max-w-4xl grid-cols-3 gap-4 sm:grid-cols-5 md:grid-cols-8">
  {
    names.map((n) => (
      <div class="flex flex-col items-center gap-1 text-white">
        <Icon name={n} class="size-10 drop-shadow-[3px_3px_0_rgba(0,0,0,.5)]" />
        <span class="font-pixel text-ui-xs tracking-wide text-white/80">{n}</span>
      </div>
    ))
  }
</div>
