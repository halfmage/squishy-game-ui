---
import Screen from '../components/Screen.astro';
import Panel from '../components/Panel.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import KeyCap from '../components/KeyCap.astro';
import Tooltip from '../components/Tooltip.astro';
import ProgressBar from '../components/ProgressBar.astro';
import ItemSlot from '../components/ItemSlot.astro';

export const title = 'Screen · HUD';
export const bg = 'zigzag';
export const fullscreen = true;

const hotbar = [
  { icon: 'swords', hotkey: '1', selected: true },
  { icon: 'shield', hotkey: '2' },
  { icon: 'science', hotkey: '3', count: 3, color: 'red' as const },
  { icon: 'science', hotkey: '4', count: 5, color: 'blue' as const },
  { icon: 'local-fire-department', hotkey: '5', count: 12, color: 'orange' as const },
  { icon: 'key', hotkey: '6', count: 1, color: 'yellow' as const },
  { hotkey: '7' },
  { hotkey: '8' },
];
---


<Screen pattern="waves" speed="8s">
  <!-- top left: stats -->
  <div class="absolute top-4 left-4 flex w-72 flex-col gap-2">
    <ProgressBar name="HP" value={62} color="red" label="62 / 100"><Icon name="favorite" /></ProgressBar>
    <ProgressBar name="MP" value={40} color="blue" label="40 / 100"><Icon name="bolt" /></ProgressBar>
    <ProgressBar name="XP" value={1250} max={2000} color="yellow" size="sm"><Icon name="star" /></ProgressBar>
    <div class="flex items-center gap-2 pl-9">
      <Badge pill color="yellow">Lv 12</Badge>
      <Badge pulse size="sm" color="pink">LEVEL UP</Badge>
    </div>
  </div>

  <!-- top right: currency + buttons -->
  <div class="absolute top-4 right-4 flex flex-col items-end gap-3">
    <div class="flex gap-2">
      <Badge pill color="yellow"><Icon name="paid" /> 1,240</Badge>
      <Badge pill color="cyan"><Icon name="diamond" /> 18</Badge>
      <Badge pill color="dark"><Icon name="timer" /> 12:34</Badge>
    </div>
    <div class="flex gap-2">
      <Tooltip text="Map" position="bottom"><Button icon color="light" aria-label="Map"><Icon name="map" /></Button></Tooltip>
      <Tooltip text="Inventory" position="bottom">
        <span class="relative inline-flex">
          <Button icon color="light" aria-label="Inventory"><Icon name="backpack" /></Button>
          <Badge pill size="sm" color="red" class="absolute -top-2 -right-2">3</Badge>
        </span>
      </Tooltip>
      <Tooltip text="Pause" position="bottom"><Button icon color="light" aria-label="Pause"><Icon name="pause" /></Button></Tooltip>
    </div>
  </div>

  <!-- center: crosshair + interaction hint -->
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-6">
    <Icon name="add" class="size-10 text-white drop-shadow-[3px_3px_0_rgba(0,0,0,.5)]" />
    <KeyCap hint="Open chest">E</KeyCap>
  </div>

  <!-- left middle: quest -->
  <div class="absolute bottom-28 left-4 w-64">
    <Panel title="Quest" color="purple">
      <Icon name="flag" slot="icon" />
      <p>Find the golden key in the sunken temple.</p>
      <ProgressBar value={2} max={3} segments={3} color="purple" size="sm" />
    </Panel>
  </div>

  <!-- bottom right: minimap -->
  <div class="absolute right-4 bottom-4 w-40">
    <Panel title="Map" color="dark">
      <Icon name="explore" slot="icon" />
      <div class="relative -m-6 aspect-square bg-emerald-800/80">
        <span class="absolute top-1/2 left-1/2 size-3 -translate-1/2 rounded-full border-2 border-black bg-yellow-300"></span>
        <span class="absolute top-6 right-6 size-2 rounded-full bg-red-500"></span>
        <span class="absolute bottom-8 left-8 size-2 rounded-full bg-red-500"></span>
      </div>
    </Panel>
  </div>

  <!-- bottom center: hotbar -->
  <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 gap-3">
    {hotbar.map((s) => <ItemSlot {...s} />)}
  </div>
</Screen>
