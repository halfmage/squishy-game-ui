---
import BrandButton from '../components/BrandButton.astro';
import PixelIcon from '../components/PixelIcon.astro';
import Heading from '../components/Heading.astro';

export const title = 'Brands';
export const bg = 'stripes';
---

<Heading>Brand themes</Heading>

<p class="max-w-lg text-center text-ui-sm leading-loose tracking-wide text-white">
  A brand theme is a class on the html element that overrides the shape tokens: radius, border,
  shadow, button highlight, gradient, and the surface colors. Pick one in the top right or press B.
  It applies to every page. Dark mode (D) works on top of every theme.
</p>

<section class="flex w-full max-w-2xl flex-col items-center gap-3">
  <span class="story-label">tokens a theme can override</span>
  <div class="flex flex-wrap justify-center gap-2">
    {
      ['--radius', '--radius-sm', '--border-w', '--border-w-sm', '--border-color', '--shadow-hard', '--shadow-hard-lg', '--shadow-hard-sm', '--btn-highlight', '--gradient-to', '--surface-*'].map((t) => (
        <code class="rounded-(--radius-sm) bg-black/50 px-2 py-0.5 font-pixel text-ui-xs text-white">{t}</code>
      ))
    }
  </div>
</section>

<Heading class="mt-6 text-ui-lg!">Legacy one-off buttons</Heading>

<p class="max-w-lg text-center text-ui-sm leading-loose tracking-wide text-white">
  The original looks, kept in styles/brands.css as a reference for the themes above.
</p>

<BrandButton variant="opacity" class="w-full">
  <PixelIcon name="x" class="animate-rotate-lift" />
  <span class="rainbow-text uppercase">Subscribe to my X</span>
  <PixelIcon name="x" class="animate-rotate-lift" />
</BrandButton>

<BrandButton variant="press" class="w-full"><PixelIcon name="plug" /> Install Plugins</BrandButton>

<BrandButton variant="deck" class="w-full">Play your Cards <PixelIcon name="cards" /></BrandButton>

<BrandButton variant="blocky" class="w-full"><PixelIcon name="cube" /> Explore Worlds</BrandButton>

<BrandButton variant="rainbow" class="w-full"><PixelIcon name="cube" /> Rainbow</BrandButton>

<div class="flex gap-5">
  <BrandButton variant="simple">Settings <PixelIcon name="settings" /></BrandButton>
  <BrandButton variant="simple">User <PixelIcon name="user" /></BrandButton>
  <BrandButton variant="simple">Share <PixelIcon name="share" /></BrandButton>
</div>
