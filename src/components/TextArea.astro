---
/** Multi-line text field. Uses the same variants as InputField. */
import { variants, inputSizes, type InputVariant, type InputSize } from './InputField.astro';

interface Props {
  variant?: InputVariant;
  size?: InputSize;
  name?: string;
  placeholder?: string;
  value?: string;
  rows?: number;
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'light',
  size = 'md',
  name,
  placeholder,
  value,
  rows = 4,
  disabled = false,
  class: className,
} = Astro.props;
---

<textarea
  name={name}
  placeholder={placeholder}
  rows={rows}
  disabled={disabled}
  class:list={[variants[variant], inputSizes[size] || null, 'input-area', className]}>{value}</textarea
>
