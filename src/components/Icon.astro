---
/**
 * Icons from Pixelarticons (https://pixelarticons.com), loaded by astro-icon
 * from node_modules/pixelarticons/svg. Use the file name:
 *   <Icon name="heart" />   <Icon name="sword" />   <Icon name="gear" />
 * Full Iconify names also work when the set is installed: <Icon name="material-symbols:home-rounded" />
 */
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  name: string;
  class?: string;
  /** aria-label makes the icon meaningful; without it the icon is decorative */
  'aria-label'?: string;
}

const { name, class: className, 'aria-label': ariaLabel } = Astro.props;
---

<AstroIcon name={name} class={className} aria-label={ariaLabel} aria-hidden={ariaLabel ? undefined : 'true'} />
