---
/**
 * Squishy radio. Group radios with the same `name`.
 *   <Radio name="mode" value="easy" checked>Easy</Radio>
 */
import { accentStyle, type AccentName } from './palette';

interface Props {
  name: string;
  value: string;
  checked?: boolean;
  disabled?: boolean;
  color?: AccentName;
  class?: string;
}

const { name, value, checked = false, disabled = false, color = 'green', class: className } =
  Astro.props;
---

<label class:list={['choice-field', className]} style={accentStyle(color)}>
  <input type="radio" name={name} value={value} checked={checked} disabled={disabled} />
  <span class="choice-box is-radio"></span>
  <slot />
</label>
