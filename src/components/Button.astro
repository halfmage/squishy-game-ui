---
/**
 * General squishy button.
 *
 *   <Button color="green" size="lg" href="/play"><Icon name="play" /> Play</Button>
 *   <Button as="button" type="submit" color="blue">Save</Button>
 *   <Button icon color="red" aria-label="Close"><Icon name="close" /></Button>
 *
 * Colors: see components/palette.ts. Sizes: md (default) | lg.
 */
import Icon from './Icon.astro';
import { colorStyle, type ColorName } from './palette';

/** md = base size (no extra class), lg = large */
export const sizes = { md: '', lg: 'btn-lg' } as const;
export type ButtonSize = keyof typeof sizes;

interface Props {
  /** Render an <a> (default) or a <button> */
  as?: 'a' | 'button';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  color?: ColorName;
  size?: ButtonSize;
  /** Icon-only: square shape. Give it an aria-label. */
  icon?: boolean;
  disabled?: boolean;
  loading?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  'aria-label'?: string;
}

const {
  as = 'a',
  href = '#',
  type = 'button',
  color = 'zinc',
  size = 'md',
  icon = false,
  disabled = false,
  loading = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'btn',
  sizes[size] || null,
  icon && 'btn-icon',
  disabled && 'is-disabled',
  loading && 'is-loading',
  className,
];
const style = colorStyle(color);
---

{
  as === 'button' ? (
    <button
      type={type}
      disabled={disabled}
      aria-busy={loading || undefined}
      class:list={classes}
      style={style}
      {...rest}
    >
      <span class="btn-content"><slot /></span>
      {loading && <span class="btn-spinner"><Icon name="loader" /></span>}
    </button>
  ) : (
    <a
      href={disabled ? undefined : href}
      aria-disabled={disabled || undefined}
      tabindex={disabled ? -1 : undefined}
      aria-busy={loading || undefined}
      class:list={classes}
      style={style}
      {...rest}
    >
      <span class="btn-content"><slot /></span>
      {loading && <span class="btn-spinner"><Icon name="loader" /></span>}
    </a>
  )
}
