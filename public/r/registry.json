{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "squishy",
  "homepage": "https://halfmage.github.io/squishy-game-ui",
  "items": [
    {
      "name": "styles",
      "type": "registry:item",
      "title": "Squishy styles",
      "description": "Tailwind v4 stylesheet with the type scale, shape tokens, light/dark surfaces, brand themes and every component class. Needs the m6x11plus font in src/assets/fonts.",
      "dependencies": [
        "tailwindcss",
        "@tailwindcss/vite"
      ],
      "files": [
        {
          "path": "src/styles/global.css",
          "type": "registry:file",
          "target": "~/src/styles/global.css"
        },
        {
          "path": "src/styles/brands.css",
          "type": "registry:file",
          "target": "~/src/styles/brands.css"
        },
        {
          "path": "src/components/palette.ts",
          "type": "registry:file",
          "target": "~/src/components/palette.ts"
        }
      ],
      "docs": "Add `@import \"./styles/global.css\"` to your layout and put m6x11plus.ttf in src/assets/fonts (https://managore.itch.io/m6x11). Enable the Tailwind Vite plugin in astro.config.mjs.",
      "categories": [
        "foundation"
      ]
    },
    {
      "name": "icon",
      "type": "registry:item",
      "title": "Icon",
      "description": "Pixelarticons (pixelarticons.com) via astro-icon. <Icon name=\"sword\" />",
      "dependencies": [
        "astro-icon",
        "pixelarticons"
      ],
      "files": [
        {
          "path": "src/components/Icon.astro",
          "type": "registry:file",
          "target": "~/src/components/Icon.astro"
        }
      ],
      "docs": "Add `icon({ iconDir: 'node_modules/pixelarticons/svg' })` from astro-icon to integrations in astro.config.mjs.",
      "categories": [
        "foundation"
      ]
    },
